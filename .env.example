# Local development, Vercel, or a custom domain:
VITE_BASE_PATH=/
# GitHub Pages project site: use /your-repository-name/ instead.
# VITE_* values are public build-time configuration. Never put secrets here.

# Reserved for future shared storage; unused by the current local MVP.
# Copy the project URL and public anon key when Supabase is reconnected.
# Never use a secret/service-role key in frontend configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
